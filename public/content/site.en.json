      "id": "terminator",
      "n": "03",
      "title": "Terminator",
      "subtitle": "Termo (Portuguese Wordle) solver",
      "tagline": "Entropy-driven Portuguese word solver.",
      "year": "2023",
      "role": "Full stack",
      "timeline": "1 month",
      "stack": [
        "Vue 3",
        "TypeScript",
        "Entropy"
      ],
      "tag": "tool",
      "img": "/assets/logo.png",
      "desc": "A wordle-solver tuned to the Portuguese language corpus, with entropy-based guess scoring. Available on GitHub Pages.",
      "links": {
        "github": "github.com/Dani12600000/terminator",
        "live": null
      },
      "caseStudy": {
        "sections": [
          {
            "num": "01",
            "title": "Problem",
            "body": "Termo (the Portuguese Wordle) went viral in 2023. I wanted to understand mathematically what the optimal first word is — and build a tool that plays optimally using information theory."
          },
          {
            "num": "02",
            "title": "Approach",
            "body": "Each guess is scored by how much entropy it removes from the remaining word space. The word with the highest expected information gain is always suggested — regardless of whether it feels intuitive.",
            "code": {
              "lang": "ts",
              "filename": "entropy.ts",
              "tokens": [
                {
                  "t": "// entropy.ts",
                  "c": "comment"
                },
                {
                  "t": "\n",
                  "c": "plain"
                },
                {
                  "t": "function",
                  "c": "keyword"
                },
                {
                  "t": " ",
                  "c": "plain"
                },
                {
                  "t": "score",
                  "c": "fn"
                },
                {
                  "t": "(word: ",
                  "c": "plain"
                },
                {
                  "t": "string",
                  "c": "keyword"
                },
                {
                  "t": ", remaining: ",
                  "c": "plain"
                },
                {
                  "t": "string",
                  "c": "keyword"
                },
                {
                  "t": "[]) {\n",
                  "c": "plain"
                },
                {
                  "t": "  const",
                  "c": "keyword"
                },
                {
                  "t": " patterns = ",
                  "c": "plain"
                },
                {
                  "t": "groupByPattern",
                  "c": "fn"
                },
                {
                  "t": "(word, remaining);\n",
                  "c": "plain"
                },
                {
                  "t": "  return",
                  "c": "keyword"
                },
                {
                  "t": " ",
                  "c": "plain"
                },
                {
                  "t": "entropy",
                  "c": "fn"
                },
                {
                  "t": "(patterns);\n",
                  "c": "plain"
                },
                {
                  "t": "}",
                  "c": "plain"
                }
              ]
            }
          },
          {
            "num": "03",
            "title": "Build",
            "bullets": [
              "Portuguese dictionary filtered and normalised with optional accent stripping.",
              "Pure entropy algorithm — no manual heuristics or curated word lists.",
              "Vue 3 + TypeScript UI with per-letter pattern feedback.",
              "Static deploy on GitHub Pages, no backend needed."
            ]
          },
          {
            "num": "04",
            "title": "Outcome",
            "body": "The solver consistently solves Termo in 3–4 guesses. More than a tool, it was an exercise in applying information theory to a concrete, fun problem."
          }
        ]
      }
    },
