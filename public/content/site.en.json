    {
      "id": "office-showdown",
      "n": "01",
      "title": "Office Showdown",
      "subtitle": "Real-time tournament + game show platform for office events",
      "tagline": "Healthy competition between colleagues, on the office projector.",
      "year": "2026",
      "role": "Design + Engineering",
      "timeline": "in development",
      "stack": [
        "Nuxt 4",
        "Vue 3",
        "TypeScript",
        "Supabase",
        "Vuetify 4"
      ],
      "tag": "hobby",
      "img": "/assets/logo-office-showdown.png",
      "desc": "A hybrid tournament and game show platform for office events. A central screen shows the live bracket and ongoing games. Colleagues join by phone via QR code — as players, audience, or admins.",
      "links": {
        "github": "github.com/Dani12600000/office-showdown",
        "live": "https://office-showdown-drab.vercel.app/"
      },
      "caseStudy": {
        "sections": [
          {
            "num": "01",
            "title": "Problem",
            "body": "Team events tend to be passive — someone presents, everyone watches. I wanted to create something that puts colleagues in genuine competition with each other, with tension, an audience, and spectacle — no app install needed."
          },
          {
            "num": "02",
            "title": "Solution",
            "body": "A platform where a projector/TV shows the live tournament and each colleague uses their phone as a controller, joining via QR code. The admin controls the show — casting draw, match presentation, round advancement. Critical game logic runs in Postgres functions on the server to prevent cheating and race conditions.",
            "code": {
              "lang": "ts",
              "filename": "usePartida.ts",
              "tokens": [
                {
                  "t": "// atomic resolution on the server",
                  "c": "comment"
                },
                {
                  "t": "\n",
                  "c": "plain"
                },
