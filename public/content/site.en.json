                  "c": "plain"
                },
                {
                  "t": "\n  });",
                  "c": "plain"
                }
              ]
            }
          },
          {
            "num": "03",
            "title": "Features",
            "bullets": [
              "Username/password auth with profiles and avatars (Supabase Storage).",
              "Lobby with casting, bots, preferences (Play/Audience) and automatic draw.",
              "Full tournament engine: auto bracket, match reveal, round advancement, champion.",
              "Rock-Paper-Scissors best-of-3 with a 5s synchronized reveal across all screens.",
              "Fullscreen Projector view with entry QR, live bracket and confetti for the champion.",
              "Realtime on everything via Supabase — zero polling, live events."
            ]
          },
          {
            "num": "04",
            "title": "Current state",
            "body": "Under active development. The tournament engine and Rock-Paper-Scissors are complete. On the roadmap: Tic-Tac-Toe, Connect Four, Battleship, and a betting system with coins for the audience."
          }
        ]
      }
