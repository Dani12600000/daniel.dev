      "title": "Office Showdown",
      "subtitle": "Torneios + game show para eventos de escritório — em tempo real",
      "tagline": "Competitividade saudável entre colegas, no projetor da sala.",
      "year": "2026",
      "role": "Design + Engenharia",
      "timeline": "em desenvolvimento",
      "stack": [
        "Nuxt 4",
        "Vue 3",
        "TypeScript",
